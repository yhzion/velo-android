# Settings every script in tools/perf reads (sourced). Set any of them in the environment.
#
#   ADB_SERIAL          the device, as `adb -s` takes it; unset: adb's only device
#   VELO_PKG            the app's package
#   VELO_PERF_SESSION   the Rex session the device's Velo shows (`setup.sh` makes it)
#   VELO_PERF_OUT       where traces and scratch files go
#   VELO_PERF_TEXT      a UTF-8 text file the prose scenes print; unset: `load.py prose`
#                       makes Korean text of its own
PERF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PERF_ROOT=$(cd "$PERF_DIR/../.." && pwd)
: "${VELO_PKG:=io.github.yhzion.velo}"
: "${VELO_PERF_SESSION:=velo-perf}"
: "${VELO_PERF_OUT:=$PERF_ROOT/build/perf}"
ADB="$PERF_DIR/adb.sh"
export ADB_SERIAL VELO_PKG VELO_PERF_SESSION VELO_PERF_OUT VELO_PERF_TEXT

# Input for window N (1 is the first tab) of the perf session, Enter appended.
perf_send() {
  rex send -s "$VELO_PERF_SESSION" -w "$1" "$2"$'\n'
}
